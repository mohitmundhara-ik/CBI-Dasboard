# Copy to Vercel → Project → Settings → Environment Variables.
# Never commit real values. Never paste secrets into chat.

# Protects every /api/sync/* route. Generate: openssl rand -hex 32
SYNC_KEY=

# Where adapters write JSON snapshots (Vercel KV / Blob / your own endpoint).
SNAPSHOT_WRITE_URL=
SNAPSHOT_TOKEN=

# BigQuery — service account with BigQuery Data Viewer + Job User on the project.
# Paste the whole JSON key, or base64 it first (safer for multi-line values):
#   base64 -w0 key.json
BQ_SA_KEY=
BQ_PROJECT=ik-marketing-data
BQ_TABLE=ik-marketing-data.India_Leads.FDE_India_live_sheet

# HubSpot private app, read scopes: crm.objects.contacts.read, crm.objects.deals.read
HUBSPOT_TOKEN=

# Google Search Console (OAuth client + refresh token for the property owner)
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_SITE=https://becomeanfde.com/

# GA4 (service account JSON, base64-encoded)
GA4_PROPERTY=
GA4_SA_KEY=

# Zoom server-to-server OAuth app, scopes: webinar:read:admin, report:read:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Existing auth (already in use)
GOOGLE_CLIENT_ID=
AUTH_SECRET=
ALLOWED_DOMAIN=interviewkickstart.com
ALLOWED_EMAILS=
